FROM node:22.17.0-alpine
WORKDIR /app

# Copy everything — no manual package.json enumeration that breaks when packages change
COPY . .

# Install dependencies
RUN corepack enable && pnpm install --frozen-lockfile

# Build auth — generates auth's own Prisma client from apps/auth/prisma/schema.prisma
# (auth is self-contained: no workspace deps, no shared Prisma client, ready to
# extract to its own repo)
RUN pnpm --filter @kloudi/auth build

EXPOSE 3004
# Migrations are managed by the API service (single source of truth at prisma/migrations/).
# When auth moves to its own repo, it will own its migrations and switch to:
#   CMD sh -c "pnpm prisma:migrate && pnpm start"
CMD ["pnpm", "--filter", "@kloudi/auth", "start"]
