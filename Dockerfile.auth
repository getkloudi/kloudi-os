FROM node:22.17.0-alpine
WORKDIR /app

# Copy everything — no manual package.json enumeration that breaks when packages change
COPY . .

# Install dependencies
RUN corepack enable && pnpm install --frozen-lockfile

# Build auth and its only workspace dep (@kloudi/shared for Logger). When auth
# extracts to its own repo, this resolves @kloudi/shared from npm and the
# turbo dep traversal collapses to a single-package build.
RUN pnpm exec turbo run build --filter=@kloudi/auth...

EXPOSE 3004
# Migrations are managed by the API service (single source of truth at prisma/migrations/).
# When auth moves to its own repo, it will own its migrations and switch to:
#   CMD sh -c "pnpm prisma:migrate && pnpm start"
CMD ["pnpm", "--filter", "@kloudi/auth", "start"]
