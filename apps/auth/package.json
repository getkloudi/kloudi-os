{
  "name": "@kloudi/auth",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.2.7",
    "@prisma/client": "^7.3.0",
    "@prisma/client-runtime-utils": "^7.3.0",
    "better-auth": "^1.2.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pino": "^9.5.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.1.0",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3"
  }
}
