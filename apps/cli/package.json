{
  "name": "@kloudi-os/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal CLI for all Kloudi agents and tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitishMehrotra/kloudi-os.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kloudi": "./dist/kloudi-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node dist/kloudi-cli.js",
    "build": "tsc",
    "start": "node dist/kloudi-cli.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "kloudi": "node dist/kloudi-cli.js"
  },
  "dependencies": {
    "@kloudi-os/infrastructure": "workspace:*",
    "@kloudi-os/sdk": "workspace:*",
    "@kloudi-os/shared": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.4.2",
    "glob": "^13.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "30.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "cli",
    "agents",
    "tools",
    "ai",
    "auto-discovery"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
