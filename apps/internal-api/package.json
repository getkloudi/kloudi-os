{
  "name": "@kloudi/internal-api",
  "version": "0.1.0",
  "type": "module",
  "description": "Internal ops API with elevated access for the kloudi.os admin dashboard",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "nodemon dist/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kloudi-os/infrastructure": "workspace:*",
    "@kloudi-os/shared": "workspace:*",
    "@prisma/client": "^7.3.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "nodemon": "3.1.11",
    "typescript": "^5.9.3"
  },
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
