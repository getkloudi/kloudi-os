{
  "name": "kloudi",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "author": "nitishmehrotra@gmail.com",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build && turbo run dev --parallel",
    "build:watch": "pnpm exec tsc --build --watch",
    "dev:api": "pnpm --filter @kloudi-os/api dev",
    "dev:web": "pnpm --filter @kloudi-os/web dev",
    "dev:cli": "pnpm --filter @kloudi-os/cli dev",
    "dev:ops": "pnpm --filter @kloudi-os/ops dev",
    "dev:internal-api": "pnpm --filter @kloudi-os/internal-api dev",
    "dev:mcp": "node apps/mcp-server/dist/index.js",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "turbo run type-check",
    "test": "turbo run test --parallel",
    "test:ci": "turbo run test:ci",
    "test:scripts": "NODE_OPTIONS='--experimental-vm-modules' jest __tests__/scripts.test.js --runInBand",
    "test:e2e": "node apps/web/e2e/workflow.spec.js",
    "schema:build": "pnpm exec tsx packages/infrastructure/database/build-schema.ts build",
    "schema:watch": "pnpm exec tsx packages/infrastructure/database/build-schema.ts watch",
    "schema:validate": "pnpm exec tsx packages/infrastructure/database/build-schema.ts validate",
    "db:generate": "pnpm schema:build && pnpm exec prisma generate",
    "db:push": "pnpm schema:build && pnpm exec prisma db push",
    "db:migrate": "pnpm schema:build && pnpm exec prisma migrate dev",
    "db:reset": "pnpm schema:build && pnpm exec prisma migrate reset",
    "db:seed": "node --env-file=.env packages/core/dist/prisma/seed.js",
    "db:studio": "pnpm exec prisma studio",
    "clean:dist": "rm -rf packages/*/dist apps/*/dist",
    "clean": "pnpm clean:dist && turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@swc/core": "^1.15.24",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.1.0",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "5.3.1",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "^9.1.7",
    "jest": "30.2.0",
    "lint-staged": "^16.4.0",
    "ms": "^2.1.3",
    "nodemon": "3.1.11",
    "prettier": "3.8.1",
    "prisma": "^7.3.0",
    "supertest": "7.2.2",
    "tsx": "^4.21.0",
    "turbo": "2.8.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.2",
    "fuse-native": "^2.2.6"
  }
}
