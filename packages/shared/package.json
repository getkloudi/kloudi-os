{
  "name": "@kloudi-os/shared",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared types, utilities, and constants for the Kloudi platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./config/auto-load": {
      "types": "./dist/config/auto-load.d.ts",
      "import": "./dist/config/auto-load.js"
    },
    "./config/auto-load-cwd": {
      "types": "./dist/config/auto-load-cwd.d.ts",
      "import": "./dist/config/auto-load-cwd.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./prompt-manager": {
      "types": "./dist/prompt-manager/index.d.ts",
      "import": "./dist/prompt-manager/index.js"
    },
    "./crypto/credentials": {
      "types": "./dist/crypto/credentials.d.ts",
      "import": "./dist/crypto/credentials.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "braintrust": "^0.0.189",
    "js-yaml": "^4.1.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "30.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "shared",
    "types",
    "utilities",
    "constants",
    "logger",
    "kloudi"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getkloudi/kloudi-os.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/__tests__/**",
    "README.md"
  ]
}
