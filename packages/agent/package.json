{
  "name": "@kloudi/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent runtime for executing SOPs (Standard Operating Procedures) in lore.dev",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./runtime.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./context.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./executor.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kloudi/core": "workspace:*",
    "@kloudi/tools": "workspace:*",
    "@kloudi/infrastructure": "workspace:*",
    "@kloudi/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "30.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "agent",
    "runtime",
    "sop",
    "execution",
    "lore.dev"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
