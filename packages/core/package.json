{
  "name": "@kloudi/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Core business logic for Decision and Pattern domains",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decisions": {
      "types": "./dist/decisions/index.d.ts",
      "import": "./dist/decisions/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js"
    },
    "./sops": {
      "types": "./dist/sops/index.d.ts",
      "import": "./dist/sops/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js"
    },
    "./organization/integration-service": {
      "types": "./dist/organization/integration-service.d.ts",
      "import": "./dist/organization/integration-service.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kloudi-os/infrastructure": "workspace:*",
    "@kloudi-os/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "30.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "core",
    "decisions",
    "patterns",
    "business-logic",
    "domain-driven"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
