// Core Domain Models
// Decision management, pattern templates, and procedural entities

model Decision {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("draft")  // draft, published, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("decisions")
}

model Pattern {
  id          String   @id @default(cuid())
  name        String
  description String?
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("patterns")
}

model Procedure {
  id          String   @id @default(cuid())
  slug        String
  name        String
  description String?
  level       String   @default("task")      // guide, project, task, skill
  maturity    String   @default("draft")     // draft, curated, validated
  graph       Json     @default("{\"nodes\": [], \"edges\": []}")
  parameters  Json     @default("{}")
  constraints Json     @default("{}")
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  Execution[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([level])
  @@index([maturity])
  @@map("procedures")
}

model Execution {
  id            String   @id @default(cuid())
  procedureId   String
  procedureSlug String
  procedureName String
  params        Json     @default("{}")
  status        String   @default("pending")  // pending, running, completed, failed
  progress      Int      @default(0)
  steps         Json     @default("[]")
  logs          Json     @default("[]")
  result        Json?
  error         String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  workspaceId   String

  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
  @@index([workspaceId])
  @@index([status])
  @@map("executions")
}
