// Core Domain Models — kloudi
// SOPs, Executions, Integrations

model Sop {
  id              String   @id @default(cuid())
  slug            String
  name            String
  description     String?
  level           String   @default("task")    // playbook, artifact, role
  maturity        String   @default("draft")   // draft, curated, validated
  graph           Json     @default("{\"nodes\": [], \"edges\": []}")
  parameters      Json     @default("{}")
  constraints     Json     @default("{}")
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags            String[] @default([])
  metadata        Json     @default("{}")
  executionCount  Int      @default(0)
  successCount    Int      @default(0)
  avgDurationMs   Int?
  avgTokensUsed   Int?

  // Marketplace fields — null until V4, accumulate quality signal from V0
  source          String   @default("org-created")  // org-created, marketplace, machine-generated
  version         String   @default("1.0.0")
  qualityScore    Float?
  isPublic        Boolean  @default(false)
  marketplaceId   String?

  executions      Execution[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([level])
  @@index([maturity])
  @@map("sops")
}

model Execution {
  id             String    @id @default(cuid())
  sopId          String
  status         String    @default("pending")  // pending, running, waiting_input, completed, failed, cancelled
  parameters     Json      @default("{}")
  variables      Json      @default("{}")        // accumulated node outputs
  currentNodeId  String?
  result         Json?
  error          String?
  tokensUsed     Int       @default(0)
  durationMs     Int?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  organizationId String
  userId         String?
  triggeredBy    String    @default("user")      // user, webhook, scheduler

  sop            Sop             @relation(fields: [sopId], references: [id], onDelete: Cascade)
  executionNodes ExecutionNode[]

  @@index([sopId])
  @@index([organizationId])
  @@index([status])
  @@map("executions")
}

model ExecutionNode {
  id            String    @id @default(cuid())
  executionId   String
  nodeId        String
  status        String    @default("pending")  // pending, running, completed, failed, waiting_input
  attemptNumber Int       @default(1)
  input         Json?
  output        Json?
  decisionTrace Json?
  gateContext   Json?
  tokensUsed    Int       @default(0)
  durationMs    Int?
  startedAt     DateTime?
  completedAt   DateTime?

  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, nodeId, attemptNumber])
  @@index([executionId])
  @@map("execution_nodes")
}

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  type           String   // github, jira, slack, confluence
  name           String
  credentials    Json     @default("{}")  // Encrypted with AES-256-GCM via IntegrationService
  config         Json     @default("{}")
  status         String   @default("active") // active, inactive, error
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, type])
  @@index([organizationId])
  @@map("integrations")
}

model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  product        String   // 'mcp-gateway' | 'kloudi-machine'
  eventType      String   // 'tool_call' | 'sop_execution' | 'agent_session'
  units          Int      @default(1)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([product])
  @@index([createdAt])
  @@map("usage_events")
}

model BillingSubscription {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  product              String    // 'mcp-gateway' | 'kloudi-machine'
  tier                 String    @default("free") // free | pro | enterprise
  status               String    @default("active") // active | cancelled | past_due
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([organizationId])
  @@map("billing_subscriptions")
}
