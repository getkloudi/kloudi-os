{
  "name": "@kloudi-os/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed HTTP client for the kloudi.os API — used by CLI, MCP server, and external integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nitishMehrotra/kloudi-os.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kloudi",
    "sdk",
    "api-client"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
