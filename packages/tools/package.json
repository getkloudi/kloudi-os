{
  "name": "@kloudi/tools",
  "version": "0.1.0",
  "type": "module",
  "description": "Tool registry and built-in tool adapters for lore.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./builtin": {
      "types": "./dist/builtin/index.d.ts",
      "import": "./dist/builtin/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kloudi/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@octokit/rest": "^22.0.1",
    "@slack/web-api": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "jest": "30.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tools",
    "registry",
    "mcp",
    "github",
    "filesystem",
    "shell"
  ],
  "author": "nitishmehrotra@gmail.com",
  "license": "SEE LICENSE IN ../../LICENSE"
}
