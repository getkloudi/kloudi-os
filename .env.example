# Copy to .env and fill in your values: cp .env.example .env
#
# These are loaded by the Config system (packages/shared/config).
# In production, set these in your hosting dashboard (Render, Fly, etc.)

# Database (PostgreSQL)
DATABASE_URL=postgresql://kloudi:kloudi_dev_password@localhost:5432/kloudi_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must be at least 32 characters)
JWT_SECRET=

# API
PORT=3001
NODE_ENV=development

# AI providers (add the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
