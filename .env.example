# Copy to .env and fill in your values: cp .env.example .env
#
# These are loaded by the Config system (packages/shared/config).
# In production, set these in your hosting dashboard (Render, Fly, etc.)

# Database (PostgreSQL)
DATABASE_URL=postgresql://kloudi:kloudi_dev_password@localhost:5432/kloudi_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must be at least 32 characters)
JWT_SECRET=

# API
PORT=3001
NODE_ENV=development

# AI providers (add the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Internal Ops API (apps/internal-api)
OPS_API_PORT=3002
OPS_CORS_ORIGINS=http://localhost:3003
OPS_GOOGLE_CLIENT_ID=
OPS_GOOGLE_CLIENT_SECRET=
OPS_GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback
OPS_ALLOWED_EMAILS=

# Ops Dashboard (apps/ops)
NEXT_PUBLIC_OPS_API_URL=http://localhost:3002

# Auth service (apps/auth-service)
AUTH_SERVICE_URL=http://localhost:3004
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3004
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
RESEND_API_KEY=re_...

# GitHub OAuth
# Create at: github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: https://kloudi.ai
# Callback URL: https://auth.kloudi.ai/api/auth/callback/github
# For local dev callback: http://localhost:3004/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create at: console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# Authorised redirect URI: https://auth.kloudi.ai/api/auth/callback/google
# For local dev: http://localhost:3004/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=
