# Copy to .env and fill in your values: cp .env.example .env
#
# These are loaded by the Config system (packages/shared/config).
# In production, set these in your hosting dashboard (Render, Fly, etc.)

# Database (PostgreSQL)
DATABASE_URL=postgresql://kloudi:kloudi_dev_password@localhost:5432/kloudi_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must be at least 32 characters)
JWT_SECRET=

# API
PORT=3001
NODE_ENV=development

# AI providers (add the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Internal Ops API (apps/internal-api)
OPS_API_PORT=3002
OPS_CORS_ORIGINS=http://localhost:3003
OPS_GOOGLE_CLIENT_ID=
OPS_GOOGLE_CLIENT_SECRET=
OPS_GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback
OPS_ALLOWED_EMAILS=

# Ops Dashboard (apps/ops)
NEXT_PUBLIC_OPS_API_URL=http://localhost:3002
