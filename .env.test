# Test environment configuration
# Used by Jest tests and CI. Committed to git (no secrets).

# Database (matches CI postgres service and local docker-compose)
DATABASE_URL=postgresql://test:test@localhost:5432/test

# Redis (matches CI redis service and local docker-compose)
REDIS_URL=redis://localhost:6379

# JWT (test-only key, not a secret)
JWT_SECRET=test-jwt-secret-at-least-32-characters-long

# API
PORT=3002
NODE_ENV=test
